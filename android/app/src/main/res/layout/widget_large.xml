<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kithe" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/w_search"
        android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_search" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Search or type a URL"
            android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_voice"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_mic" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Voice" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_ai"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_ai" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="AI Mode" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
